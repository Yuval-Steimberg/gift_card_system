# =============================================================================
# gift_card_system — environment variables
#
# Every value here is OPTIONAL for local development: with nothing set, the app
# runs fully offline using the in-memory store + mock payment/email/receipt
# providers. Set these only to connect real services (Supabase, Grow, Resend…).
#
# NEXT_PUBLIC_* is exposed to the browser bundle. Everything else is server-only
# and must NEVER be prefixed with NEXT_PUBLIC_ (that would leak secrets).
# =============================================================================

# --- App -----------------------------------------------------------------
# Public base URL of THIS gift-card app (used in emails, QR links, webhooks).
APP_BASE_URL=http://localhost:3000
# IANA timezone for scheduling + display defaults.
BUSINESS_TIMEZONE=Asia/Jerusalem
# Secret used to authorize the delivery cron/worker endpoint.
CRON_SECRET=dev-cron-secret-change-me

# --- Supabase ------------------------------------------------------------
# Leave blank to use the in-memory store (default for local dev).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for privileged writes + RLS bypass on the server.
# The app refuses privileged operations if Supabase is configured without this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ------------------------------------------------------------
# mock (default, no credentials) | grow
PAYMENT_PROVIDER=mock
# HMAC secret the payment provider signs webhooks with. REQUIRED in production.
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
# Grow (grow.link / Meshulam) — only when PAYMENT_PROVIDER=grow.
# Mirrors the existing Just A Second website integration.
GROW_API_URL=https://restapi.grow.link
GROW_API_KEY=
GROW_API_SECRET=
GROW_PAGE_CODE=
# Optional: route checkout through the same Make.com scenario the JAS site uses.
# When set, the Make webhook returns the Grow payment-page URL. If empty, the
# adapter calls the Grow REST API directly (createPaymentProcess/createPaymentLink).
MAKE_WEBHOOK_URL=

# --- Email delivery ------------------------------------------------------
# log (default: writes email previews to .mail/ and logs) | resend
EMAIL_PROVIDER=log
EMAIL_FROM="Just A Second <gifts@example.com>"
RESEND_API_KEY=

# --- Accounting / receipts ----------------------------------------------
# mock (default) | greeninvoice
RECEIPT_PROVIDER=mock
GREENINVOICE_API_URL=https://api.greeninvoice.co.il
GREENINVOICE_API_KEY=
GREENINVOICE_API_SECRET=
# Document type code — CONFIRM with the accountant. 320=invoice-receipt (default),
# 400=receipt, 305=tax invoice, 300=proforma.
GREENINVOICE_DOC_TYPE=320

# --- Auth (employee/admin) ----------------------------------------------
# Session signing secret for the demo auth layer (Supabase Auth in production).
AUTH_SECRET=dev-auth-secret-change-me

# --- Monitoring (optional) ----------------------------------------------
SENTRY_DSN=
